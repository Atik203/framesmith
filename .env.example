# Active provider order: verified free model first, existing OpenAI credit last.
FRAMESMITH_LLM_PROVIDERS=openrouter,openai
FRAMESMITH_LLM_MAX_RETRIES=3

FRAMESMITH_OPENROUTER_API_KEY=
