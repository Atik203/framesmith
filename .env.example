# Active provider order: free tiers first, existing OpenAI credit last.
FRAMESMITH_LLM_PROVIDERS=gemini,openrouter,openai
FRAMESMITH_LLM_MAX_RETRIES=3

FRAMESMITH_GEMINI_API_KEY=
FRAMESMITH_GEMINI_MODEL=gemini-3.8-flash

FRAMESMITH_OPENROUTER_API_KEY=
FRAMESMITH_OPENROUTER_MODEL=qwen/qwen3.8-27b:free

FRAMESMITH_OPENAI_API_KEY=
FRAMESMITH_OPENAI_MODEL=gpt-6-luna

FRAMESMITH_GENERATION_ENABLED=true
FRAMESMITH_PUBLISHING_ENABLED=false
