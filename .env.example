# Active provider order: free models first, existing OpenAI credit last.
FRAMESMITH_LLM_PROVIDERS=openrouter,opencode,openai
FRAMESMITH_LLM_MAX_RETRIES=3

FRAMESMITH_OPENROUTER_API_KEY=
FRAMESMITH_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

FRAMESMITH_OPENCODE_API_KEY=
FRAMESMITH_OPENCODE_MODEL=nemotron-3-ultra-free

FRAMESMITH_OPENAI_API_KEY=
FRAMESMITH_OPENAI_MODEL=gpt-6-luna

FRAMESMITH_GENERATION_ENABLED=true
FRAMESMITH_PUBLISHING_ENABLED=false
