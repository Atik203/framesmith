{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framesmith/render_spec.schema.json",
  "title": "Render specification",
  "description": "Input to the Remotion compositions ShortVertical (1080x1920) and LongHorizontal (1920x1080). Blueprint Part IV 'V1 Minimal Render Specification', Part IV.5 '16:9 Long-Form Master' and R14. Asset paths are relative to the v1/ folder (assets/{id}/scene-01.png, audio/{id}.wav, subtitles/{id}.json).",
  "type": "object",
  "required": ["width", "height", "fps", "scenes", "voice", "subtitles"],
  "anyOf": [
    { "required": ["duration_seconds"] },
    { "required": ["target_duration_seconds"] }
  ],
  "additionalProperties": false,
  "properties": {
    "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,40}$" },
    "content_type": { "enum": ["short", "long_form"], "default": "short" },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "fps": { "const": 30 },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "target_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "voice": { "type": "string", "minLength": 1 },
    "subtitles": { "type": "string", "minLength": 1 },
    "music": { "type": ["string", "null"] },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "start"],
        "additionalProperties": false,
        "properties": {
          "asset": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "if": {
    "required": ["content_type"],
    "properties": { "content_type": { "const": "long_form" } }
  },
  "then": {
    "properties": {
      "width": { "const": 1920 },
      "height": { "const": 1080 },
      "scenes": { "minItems": 1 }
    }
  },
  "else": {
    "properties": {
      "width": { "const": 1080 },
      "height": { "const": 1920 },
      "scenes": { "minItems": 6, "maxItems": 10 }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["asset", "start", "duration", "motion"],
      "additionalProperties": false,
      "properties": {
        "asset": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "motion": {
          "enum": [
            "push_in",
            "push_out",
            "pan_left",
            "pan_right",
            "parallax",
            "micro_shake",
            "focus_pull",
            "cut_on_word"
          ]
        }
      }
    }
  }
}
