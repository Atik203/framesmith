{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framesmith/script.schema.json",
  "title": "Timed script (V1 story schema)",
  "description": "Timed script for one video (blueprint Part IV 'V1 Story Schema', plus the optional content_type and parent_content_id fields from the shared content object in Part V).",
  "type": "object",
  "required": [
    "content_id",
    "niche",
    "language",
    "working_title",
    "hook",
    "script",
    "estimated_duration_seconds"
  ],
  "additionalProperties": false,
  "properties": {
    "content_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,40}$",
      "description": "Convention: lf-short-001, lf-long-001."
    },
    "content_type": { "enum": ["short", "long_form"], "default": "short" },
    "parent_content_id": {
      "type": ["string", "null"],
      "description": "Set on derivative Shorts to the long-form episode they came from."
    },
    "niche": { "type": "string", "minLength": 1 },
    "language": { "const": "en" },
    "working_title": { "type": "string", "minLength": 3 },
    "hook": { "type": "string", "minLength": 5 },
    "script": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["index", "text", "duration_seconds", "emotion", "visual"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "emotion": { "type": "string", "minLength": 1 },
          "visual": {
            "type": "string",
            "minLength": 10,
            "description": "Concrete image description: subject, setting, framing. No on-image text."
          }
        }
      }
    },
    "cta": { "type": ["string", "null"] },
    "estimated_duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
  }
}
