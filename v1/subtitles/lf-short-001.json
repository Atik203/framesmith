{
  "content_id": "lf-short-001",
  "duration_seconds": 46.14,
  "alignment_model": "tiny.en",
  "alignment_device": "cpu",
  "chunks": [
    {
      "start": 0.0,
      "end": 2.04,
      "text": "Platform Nine was sealed the"
    },
    {
      "start": 2.04,
      "end": 3.24,
      "text": "night Elias vanished."
    },
    {
      "start": 3.9,
      "end": 5.1,
      "text": "So who left wet footprints"
    },
    {
      "start": 5.1,
      "end": 6.0,
      "text": "inside?"
    },
    {
      "start": 7.24,
      "end": 8.42,
      "text": "Nora had cleaned this station"
    },
    {
      "start": 8.42,
      "end": 9.58,
      "text": "for twenty years,"
    },
    {
      "start": 10.12,
      "end": 11.6,
      "text": "still listening for his name."
    },
    {
      "start": 12.48,
      "end": 13.08,
      "text": "At midnight,"
    },
    {
      "start": 13.58,
      "end": 15.76,
      "text": "its dead timetable flickered and"
    },
    {
      "start": 15.76,
      "end": 17.48,
      "text": "printed two tickets for tomorrow."
    },
    {
      "start": 18.54,
      "end": 20.08,
      "text": "One carried Nora's name."
    },
    {
      "start": 20.42,
      "end": 21.46,
      "text": "The other read Elias,"
    },
    {
      "start": 21.54,
      "end": 22.54,
      "text": "still thirteen."
    },
    {
      "start": 23.64,
      "end": 24.38,
      "text": "At 12:17,"
    },
    {
      "start": 25.12,
      "end": 26.22,
      "text": "a white light filled the"
    },
    {
      "start": 26.22,
      "end": 26.48,
      "text": "tunnel."
    },
    {
      "start": 27.26,
      "end": 28.12,
      "text": "Nora reached out."
    },
    {
      "start": 28.12,
      "end": 30.56,
      "text": "The rails ended before the"
    },
    {
      "start": 30.56,
      "end": 30.86,
      "text": "light."
    },
    {
      "start": 31.34,
      "end": 33.86,
      "text": "No train arrived\u2014only wet prints"
    },
    {
      "start": 33.86,
      "end": 35.28,
      "text": "crossing toward her."
    },
    {
      "start": 35.92,
      "end": 37.0,
      "text": "The board changed:"
    },
    {
      "start": 37.2,
      "end": 38.4,
      "text": "You can go home now,"
    },
    {
      "start": 38.66,
      "end": 38.74,
      "text": "Nora."
    },
    {
      "start": 39.02,
      "end": 40.22,
      "text": "She followed the footprints."
    },
    {
      "start": 41.34,
      "end": 42.46,
      "text": "They led away from the"
    },
    {
      "start": 42.46,
      "end": 42.9,
      "text": "station."
    },
    {
      "start": 43.42,
      "end": 44.4,
      "text": "For the first time,"
    },
    {
      "start": 44.44,
      "end": 45.76,
      "text": "she stopped looking back."
    }
  ]
}
